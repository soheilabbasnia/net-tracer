#!/usr/bin/env python3
"""
NetTracer Desktop GUI Launcher with First-Run Auto-Bootstrap.
Automatically resolves symlinks, configures sys.path, and installs missing dependencies.
"""
import os
import sys
import subprocess

# 1. Resolve absolute real path (unwinding symlinks from ~/.local/bin or desktop launchers)
REAL_SCRIPT = os.path.realpath(__file__)
BASE_DIR = os.path.dirname(os.path.dirname(REAL_SCRIPT))

# Guarantee BASE_DIR is at the head of sys.path
if BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)
os.environ["PYTHONPATH"] = f"{BASE_DIR}:{os.environ.get('PYTHONPATH', '')}"


def bootstrap_environment():
    """Detects and switches to appropriate python environment or installs requirements."""
    conda_python = os.path.expanduser("~/Programs/miniconda3/bin/python")
    conda_pip = os.path.expanduser("~/Programs/miniconda3/bin/pip")

    # If current interpreter doesn't have PyQt6, check if miniconda does or re-exec into it
    try:
        import PyQt6
    except ImportError:
        if os.path.exists(conda_python) and sys.executable != conda_python:
            # Switch to conda environment python
            os.execv(conda_python, [conda_python, REAL_SCRIPT] + sys.argv[1:])

    # Check for required packages
    required_pkgs = ["PyQt6", "psutil"]
    missing = []
    for pkg in required_pkgs:
        try:
            __import__(pkg)
        except ImportError:
            missing.append(pkg)

    if missing:
        print(f"[NetTracer] First-run setup: Missing dependencies detected: {missing}")
        print("[NetTracer] Automatically installing dependencies...")

        pip_bin = None
        if os.path.exists(conda_pip):
            pip_bin = conda_pip
        else:
            try:
                subprocess.run([sys.executable, "-m", "pip", "--version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
                pip_bin = f"{sys.executable} -m pip"
            except Exception:
                pass

        if pip_bin:
            env = os.environ.copy()
            if "ALL_PROXY" not in env:
                env["ALL_PROXY"] = "socks5h://127.0.0.1:10808"

            cmd = [pip_bin, "install"] + missing if isinstance(pip_bin, str) and " " not in pip_bin else [sys.executable, "-m", "pip", "install"] + missing
            try:
                subprocess.run(cmd, env=env, check=True)
                print("[NetTracer] Successfully installed required dependencies.")
            except Exception as e:
                print(f"[NetTracer] Warning: Automatic install failed ({e}). Please install python-pyqt6 and python-psutil via pacman.")
        else:
            print("[NetTracer] Notice: pip not available in current environment. Please run: sudo pacman -S python-pyqt6 python-psutil")


# Run bootstrap before importing application
bootstrap_environment()

# Safe import after path and dependencies are verified
from gui.app import main

if __name__ == "__main__":
    main()
